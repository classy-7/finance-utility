# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Market Data API (Choose one or more)
# Option 1: Alpha Vantage (Free tier available)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Option 2: Twelve Data (Free tier available)
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# Option 3: Yahoo Finance (Unofficial, use at own risk)
# YAHOO_FINANCE_API_KEY=your_yahoo_finance_api_key

# Indian Market Data (Official APIs require registration)
# NSE Data Feed (Requires NSE registration)
NSE_API_KEY=your_nse_api_key
NSE_API_SECRET=your_nse_api_secret

# BSE Data Feed (Requires BSE registration)
BSE_API_KEY=your_bse_api_key
BSE_API_SECRET=your_bse_api_secret

# Mutual Fund Data
# AMFI India (Official mutual fund data)
AMFI_API_KEY=your_amfi_api_key

# News API
# Option 1: NewsAPI (Free tier available)
NEWS_API_KEY=your_news_api_key

# Option 2: GNews API
GNEWS_API_KEY=your_gnews_api_key

# Currency Exchange Rates (For currency converter)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Email Service (For contact form - Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@finwise.example.com

# Redis (For caching - Optional for production)
REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development
